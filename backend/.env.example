# Database
DATABASE_URL=postgresql+asyncpg://vmadmin:password@db:5432/vmportal

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Proxmox
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=automation
PROXMOX_TOKEN_VALUE=your-proxmox-token-here
PROXMOX_NODE=pve
PROXMOX_VERIFY_SSL=false
PROXMOX_ISO_STORAGE=local
PROXMOX_ISO_IMAGE=ubuntu-24.04-live-server-amd64.iso
PROXMOX_VM_STORAGE=local-lvm

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-default-chat-id

# Cloudflare Tunnel
CF_TUNNEL_DOMAIN=example.com
