# ===========================================
# SECURITY: These values MUST be changed!
# ===========================================

# Database
DATABASE_URL=postgresql+asyncpg://vmadmin:your_secure_password@db:5432/vmportal
DB_USER=vmadmin
# REQUIRED: Generate strong password: openssl rand -base64 32
DB_PASSWORD=your_secure_password
DB_NAME=vmportal

# JWT Security
# Option 1: HS256 (symmetric) - simpler but less secure
# REQUIRED: Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=generate-a-random-secret-key-here

# Option 2: RS256 (asymmetric) - recommended for production
# Generate keys: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Then set these (or load from files):
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# CORS Allowed Origins (comma-separated)
# REQUIRED: Set to your frontend domain(s)
ALLOWED_ORIGINS=https://portal.yourdomain.com

# Bcrypt password hashing rounds (12-14 recommended for production)
BCRYPT_ROUNDS=12

# Environment (set to 'production' in production to enforce SECRET_KEY validation)
ENVIRONMENT=development

# Proxmox VE
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=automation
PROXMOX_TOKEN_VALUE=your-proxmox-api-token-here
PROXMOX_NODE=pve
PROXMOX_VERIFY_SSL=false
PROXMOX_ISO_STORAGE=local
PROXMOX_ISO_IMAGE=ubuntu-24.04-live-server-amd64.iso
PROXMOX_VM_STORAGE=local-lvm

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_DEFAULT_CHAT_ID=your-chat-id-here

# Cloudflare Tunnel
CF_TUNNEL_DOMAIN=ssh.yourdomain.com
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cloudflare-zone-id
CF_TUNNEL_ID=your-tunnel-id
CF_TUNNEL_NAME=vm-portal
CF_BASE_DOMAIN=yourdomain.com
CF_CLOUDFLARED_CONFIG_PATH=/etc/cloudflared/config.yml

# Frontend
VITE_API_URL=/api
